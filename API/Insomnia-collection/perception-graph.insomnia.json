    {
      "_id": "__request_15__",
      "_type": "request",
      "parentId": "__request_group_4__",
      "name": "WRITE - Create session",
      "description": "Requires Perception.Manage.All and explicit approval of the playbook, one accepted input, and cost. Set private playbook_definition_id, input_kind, input_value and write_access_token. Expect 201, then clear write_access_token, copy the returned id into private session_id and monitor with GET. Never retry blindly. Reference: https://learn.microsoft.com/graph/api/agenticsecurityroot-post-sessions?view=graph-rest-beta",
      "method": "POST",
      "url": "https://graph.microsoft.com/beta/security/agenticSecurity/sessions",
      "parameters": [],
      "headers": [{"name": "Accept", "value": "application/json"}, {"name": "Content-Type", "value": "application/json"}],
      "authentication": {"type": "bearer", "token": "{{ _.write_access_token }}", "prefix": "Bearer", "disabled": false},
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"playbookDefinition@odata.bind\": \"https://graph.microsoft.com/beta/security/agenticSecurity/playbookDefinitions/{{ _.playbook_definition_id }}\",\n  \"inputs\": [\n    {\n      \"kind\": {{ _.input_kind | json }},\n      \"value\": {{ _.input_value | json }}\n    }\n  ]\n}"
      },
      "metaSortKey": 100,
      "settingEncodeUrl": true,
      "settingFollowRedirects": "off",
      "settingStoreCookies": false,
      "settingSendCookies": false
    },
